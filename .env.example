# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real secrets.

# --- Database (SteVe MariaDB, read-only user) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=steve_readonly
DB_PASSWORD=change-me
DB_NAME=stevedb

# --- MQTT broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Behaviour ---
# MQTT base topic prefix (state topics: <base>/<charge_box_id>/<metric>)
MQTT_BASE=steve
# HA MQTT discovery prefix (default for HA is "homeassistant")
DISCOVERY_PREFIX=homeassistant
# How often to poll the DB (seconds)
POLL_INTERVAL_SEC=60
# Mark a charger offline when both meter AND status are older than this (seconds)
STATUS_STALE_SEC=900
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
